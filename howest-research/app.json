{
  "expo": {
    "name": "howest-research",
    "slug": "howest-research",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/splashIcons/icon.png",
    "scheme": "howestresearch",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jana-e.howest-research",
      "icon": {
        "dark": "./assets/images/splashIcons/icon-dark.png",
        "light": "./assets/images/splashIcons/icon-light.png",
        "tinted": "./assets/images/splashIcons/icon.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/splashIcons/adaptive-icon.png",
        "backgroundImage": "./assets/images/splashIcons/adaptive-icon-background.png",
        "monochromeImage": "./assets/images/splashIcons/adaptive-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.janae.howestresearch"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/splashIcons/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splashIcons/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#232323",
          "image": "./assets/images/splashIcons/splash-icon.png",
          "dark": {
            "image": "./assets/images/splashIcons/splash-icon-dark.png",
            "backgroundColor": "#000000"
          },
          "imageWidth": 200
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/OpenSans/OpenSans-Bold.ttf",
            "./assets/fonts/OpenSans/OpenSans-BoldItalic.ttf",
            "./assets/fonts/OpenSans/OpenSans-ExtraBold.ttf",
            "./assets/fonts/OpenSans/OpenSans-ExtraBoldItalic.ttf",
            "./assets/fonts/OpenSans/OpenSans-Italic.ttf",
            "./assets/fonts/OpenSans/OpenSans-Light.ttf",
            "./assets/fonts/OpenSans/OpenSans-LightItalic.ttf",
            "./assets/fonts/OpenSans/OpenSans-Regular.ttf",
            "./assets/fonts/OpenSans/OpenSans-SemiBold.ttf",
            "./assets/fonts/OpenSans/OpenSans-SemiBoldItalic.ttf",
            "./assets/fonts/VAGRoundedStd/VAGRoundedStd-Black.otf",
            "./assets/fonts/VAGRoundedStd/VAGRoundedStd-Bold.otf",
            "./assets/fonts/VAGRoundedStd/VAGRoundedStd-Light.otf",
            "./assets/fonts/VAGRoundedStd/VAGRoundedStd-Thin.otf"
          ],
          "android": {
            "fonts": [
              {
                "fontFamily": "VAGRoundedStd",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/VAGRoundedStd/VAGRoundedStd-Black.otf",
                    "weight": "900",
                    "style": "black"
                  },
                  {
                    "path": "./assets/fonts/VAGRoundedStd/VAGRoundedStd-Bold.otf",
                    "weight": "700",
                    "style": "bold"
                  },
                  {
                    "path": "./assets/fonts/VAGRoundedStd/VAGRoundedStd-Light.otf",
                    "weight": "300",
                    "style": "light"
                  },
                  {
                    "path": "./assets/fonts/VAGRoundedStd/VAGRoundedStd-Thin.otf",
                    "weight": "100",
                    "style": "thin"
                  }
                ]
              },
              {
                "fontFamily": "OpenSans",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/OpenSans/OpenSans-Bold.ttf",
                    "weight": "700",
                    "style": "bold"
                  },
                  {
                    "path": "./assets/fonts/OpenSans/OpenSans-BoldItalic.ttf",
                    "weight": "700",
                    "style": "italic"
                  },
                  {
                    "path": "./assets/fonts/OpenSans/OpenSans-ExtraBold.ttf",
                    "weight": "800",
                    "style": "bold"
                  },
                  {
                    "path": "./assets/fonts/OpenSans/OpenSans-ExtraBoldItalic.ttf",
                    "weight": "800",
                    "style": "italic"
                  },
                  {
                    "path": "./assets/fonts/OpenSans/OpenSans-Italic.ttf",
                    "weight": "400",
                    "style": "italic"
                  },
                  {
                    "path": "./assets/fonts/OpenSans/OpenSans-Light.ttf",
                    "weight": "300",
                    "style": "light"
                  },
                  {
                    "path": "./assets/fonts/OpenSans/OpenSans-LightItalic.ttf",
                    "weight": "300",
                    "style": "italic"
                  },
                  {
                    "path": "./assets/fonts/OpenSans/OpenSans-Regular.ttf",
                    "weight": "400",
                    "style": "normal"
                  },
                  {
                    "path": "./assets/fonts/OpenSans/OpenSans-SemiBold.ttf",
                    "weight": "600",
                    "style": "bold"
                  },
                  {
                    "path": "./assets/fonts/OpenSans/OpenSans-SemiBoldItalic.ttf",
                    "weight": "600",
                    "style": "italic"
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/OpenSans/OpenSans-Bold.ttf",
              "./assets/fonts/OpenSans/OpenSans-BoldItalic.ttf",
              "./assets/fonts/OpenSans/OpenSans-ExtraBold.ttf",
              "./assets/fonts/OpenSans/OpenSans-ExtraBoldItalic.ttf",
              "./assets/fonts/OpenSans/OpenSans-Italic.ttf",
              "./assets/fonts/OpenSans/OpenSans-Light.ttf",
              "./assets/fonts/OpenSans/OpenSans-LightItalic.ttf",
              "./assets/fonts/OpenSans/OpenSans-Regular.ttf",
              "./assets/fonts/OpenSans/OpenSans-SemiBold.ttf",
              "./assets/fonts/OpenSans/OpenSans-SemiBoldItalic.ttf",
              "./assets/fonts/VAGRoundedStd/VAGRoundedStd-Black.otf",
              "./assets/fonts/VAGRoundedStd/VAGRoundedStd-Bold.otf",
              "./assets/fonts/VAGRoundedStd/VAGRoundedStd-Light.otf",
              "./assets/fonts/VAGRoundedStd/VAGRoundedStd-Thin.otf"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}